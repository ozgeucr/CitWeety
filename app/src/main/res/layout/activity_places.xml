<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvDetailsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keşif Rotası"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/tvDetailsCityName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Şehir Adı"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPlaces"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_city_card" />

</LinearLayout>