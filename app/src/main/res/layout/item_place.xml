<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="18dp" app:cardElevation="3dp" app:cardBackgroundColor="#FFFFFF" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <!--  Bayrak kutusu  -->
        <FrameLayout android:layout_width="54dp" android:layout_height="54dp" android:background="#F0F7FF" android:layout_marginEnd="14dp">
            <TextView android:id="@+id/tvCountryFlag" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="🇩🇪" android:textSize="26sp"/>
        </FrameLayout>
        <!--  Bilgiler  -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvCountryName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Almanya" android:textColor="#0D2137" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvCountryMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18 şehir · Orta Avrupa" android:textColor="#7A8FA6" android:textSize="12sp" android:layout_marginTop="3dp"/>
            <!--  Progress bar yerine basit yeşil şerit  -->
            <View android:layout_width="60dp" android:layout_height="3dp" android:background="#1D9E75" android:layout_marginTop="8dp"/>
        </LinearLayout>
        <!--  Ok işareti  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#D0D8E0" android:textSize="28sp" android:paddingStart="8dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>