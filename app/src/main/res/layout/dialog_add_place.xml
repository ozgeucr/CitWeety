<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_input_field">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Yeni Mekan Ekle"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#0D2137"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etNewPlaceName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Mekan Adı (Örn: Şirin Kafe)"
        android:background="#F8FAFC"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etNewPlaceDesc"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Kategori veya Detay"
        android:background="#F8FAFC"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSaveNewPlace"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Haritaya ve Listeye Ekle"
        android:backgroundTint="#FBBF24"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>
</LinearLayout>