<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FFF5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acil Durum Rehberi"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yardım çağırmak için numaraya dokun"
        android:textSize="16sp"
        android:layout_marginBottom="40dp"
        android:textColor="#555555"/>

    <!-- Polis Butonu -->
    <Button
        android:id="@+id/btnCallPolice"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="POLİS (112)"
        android:textSize="20sp"
        android:backgroundTint="#1976D2"
        android:layout_marginBottom="16dp"/>

    <!-- Ambulans Butonu -->
    <Button
        android:id="@+id/btnCallAmbulance"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="AMBULANS (112)"
        android:textSize="20sp"
        android:backgroundTint="#388E3C"
        android:layout_marginBottom="16dp"/>

    <!-- İtfaiye Butonu -->
    <Button
        android:id="@+id/btnCallFire"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="İTFAİYE (112)"
        android:textSize="20sp"
        android:backgroundTint="#F44336"/>

</LinearLayout>