<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="3dp" app:cardBackgroundColor="#FFFFFF" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <!--  Sol: Renkli harf kutusu  -->
        <FrameLayout android:layout_width="52dp" android:layout_height="52dp" android:background="#E8F5F1" android:layout_marginEnd="14dp">
            <TextView android:id="@+id/tvCityInitial" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="P" android:textColor="#1D9E75" android:textSize="22sp" android:textStyle="bold"/>
        </FrameLayout>
        <!--  Orta: Bilgiler  -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvCityName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Paris" android:textColor="#0D2137" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvCityDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fransa · Batı Avrupa" android:textColor="#7A8FA6" android:textSize="12sp" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/tvCityBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⭐ Popüler" android:textColor="#1D9E75" android:textSize="10sp" android:textStyle="bold" android:background="#E8F5F1" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginTop="6dp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#D0D8E0" android:textSize="28sp" android:paddingStart="8dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>