<!--
    res/drawable/bg_chip.xml
    Inactive chip — uses a semi-transparent overlay so it looks
    natural on ANY background (light surface_bg or dark navy).
    Replace your existing bg_chip.xml with this.
 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!--  Slightly elevated surface: white at 8 % in light, visible in dark  -->
    <solid android:color="#14000000"/>
    <!--  8 % black overlay  -->
    <stroke android:width="1dp" android:color="#1A000000"/>
    <!--  subtle border  -->
    <corners android:radius="24dp"/>
</shape>